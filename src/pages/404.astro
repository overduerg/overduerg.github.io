---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <div class="relative mx-auto flex max-w-3xl flex-col items-center overflow-hidden px-4 py-32 text-center sm:px-6">
    <div class="orb absolute top-10 left-1/4 h-64 w-64" aria-hidden="true"></div>

    <p class="relative font-mono text-sm tracking-[0.3em] text-accent uppercase" data-reveal>
      GAME OVER
    </p>
    <h1 class="relative mt-4 font-display text-7xl font-bold tracking-tight sm:text-9xl" data-reveal style="--i:1">
      4<span class="text-gradient">0</span>4
    </h1>
    <p class="relative mt-6 max-w-md text-muted" data-reveal style="--i:2">
      You fell out of the map. This area doesn't exist — maybe it despawned, maybe it was never
      rendered.
    </p>
    <div class="relative mt-10 flex flex-wrap justify-center gap-4" data-reveal style="--i:3">
      <a
        href="/"
        class="rounded-lg bg-accent px-6 py-3 font-display font-semibold text-white shadow-lg shadow-accent/25 transition-transform duration-200 hover:scale-105"
      >
        Respawn at home
      </a>
      <a
        href="/projects/"
        class="rounded-lg border border-line bg-panel px-6 py-3 font-display font-semibold transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        Browse games
      </a>
    </div>
  </div>
</BaseLayout>
