---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameMadeCard from '../../../components/GameMadeCard.astro';

const games = [...(await getCollection('games-made'))].sort(
  (a, b) => (b.data.releaseDate?.valueOf() ?? 0) - (a.data.releaseDate?.valueOf() ?? 0),
);
---

<BaseLayout title="Produce" description="Games I've made.">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <header class="mb-14" data-reveal>
      <p class="mb-2 font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase">
        // produce
      </p>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
        Games I've <span class="text-gradient">Made</span>
      </h1>
    </header>

    {
      games.length === 0 ? (
        <p class="text-muted">Nothing here yet — check back soon.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {games.map((game, i) => (
            <GameMadeCard game={game} index={i} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
