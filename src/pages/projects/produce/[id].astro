---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games-made');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, tagline, cover, status, engine, platforms, releaseDate, links, tags } = game.data;

const linkLabels: Record<string, string> = {
  itch: 'itch.io',
  steam: 'Steam',
  github: 'Source code',
  play: 'Play now',
};
---

<BaseLayout title={title} description={tagline}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/projects/produce/" class="text-sm text-muted transition-colors hover:text-accent"
      >&larr; Back to produce</a
    >

    <header class="mt-6 mb-10" data-reveal>
      <div class="flex flex-wrap items-center gap-2 text-xs font-medium">
        <span class="rounded-full bg-accent-soft px-2.5 py-1 text-accent">{status}</span>
        {engine && <span class="rounded-full bg-accent-soft px-2.5 py-1">{engine}</span>}
        {platforms.map((p) => <span class="rounded-full border border-line px-2.5 py-1">{p}</span>)}
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      {tagline && <p class="mt-3 text-lg text-muted">{tagline}</p>}
      {
        releaseDate && (
          <p class="mt-2 text-sm text-muted">
            Released
            <time datetime={releaseDate.toISOString()}>
              {releaseDate.toLocaleDateString('en', { year: 'numeric', month: 'long' })}
            </time>
          </p>
        )
      }
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={`${title} cover art`}
          class="mb-10 w-full rounded-xl border border-line"
          data-reveal
        />
      )
    }

    <!-- External links -->
    {
      Object.keys(links).length > 0 && (
        <div class="mb-10 flex flex-wrap gap-3" data-reveal>
          {Object.entries(links).map(([key, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-line bg-panel px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
            >
              {linkLabels[key] ?? key} &nearr;
            </a>
          ))}
        </div>
      )
    }

    <div class="prose dark:prose-invert max-w-none" data-reveal>
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">#{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
