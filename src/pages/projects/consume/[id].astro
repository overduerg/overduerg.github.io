---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games-played');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, cover, platform, status, rating, hoursPlayed, completedDate, tags } = game.data;
---

<BaseLayout title={title} description={`My thoughts on ${title}.`}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/projects/consume/" class="text-sm text-muted transition-colors hover:text-accent"
      >&larr; Back to consume</a
    >

    <header class="mt-6 mb-10" data-reveal>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <dl class="mt-6 grid grid-cols-2 gap-4 rounded-xl border border-line bg-panel p-5 sm:grid-cols-4">
        <div>
          <dt class="text-xs tracking-wider text-muted uppercase">Status</dt>
          <dd class="mt-1 font-display font-semibold capitalize">{status}</dd>
        </div>
        {platform && (
          <div>
            <dt class="text-xs tracking-wider text-muted uppercase">Platform</dt>
            <dd class="mt-1 font-display font-semibold">{platform}</dd>
          </div>
        )}
        {rating !== undefined && (
          <div>
            <dt class="text-xs tracking-wider text-muted uppercase">Rating</dt>
            <dd class="mt-1 font-display font-semibold text-accent">{rating}/10</dd>
          </div>
        )}
        {hoursPlayed !== undefined && (
          <div>
            <dt class="text-xs tracking-wider text-muted uppercase">Hours</dt>
            <dd class="mt-1 font-display font-semibold">{hoursPlayed}h</dd>
          </div>
        )}
        {completedDate && (
          <div>
            <dt class="text-xs tracking-wider text-muted uppercase">Finished</dt>
            <dd class="mt-1 font-display font-semibold">
              <time datetime={completedDate.toISOString()}>
                {completedDate.toLocaleDateString('en', { year: 'numeric', month: 'short' })}
              </time>
            </dd>
          </div>
        )}
      </dl>
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={`${title} cover art`}
          class="mb-10 w-full rounded-xl border border-line"
          data-reveal
        />
      )
    }

    <div class="prose dark:prose-invert max-w-none" data-reveal>
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">#{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
