---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../consts';

const channels = [
  {
    name: 'GitHub',
    value: CONTACT.github.replace('https://github.com/', '@'),
    href: CONTACT.github,
    icon: 'github',
    copy: false,
  },
  CONTACT.email && {
    name: 'Email',
    value: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
    icon: 'mail',
    copy: true,
  },
  CONTACT.discord && {
    name: 'Discord',
    value: CONTACT.discord,
    href: undefined,
    icon: 'discord',
    copy: true,
  },
  CONTACT.twitter && {
    name: 'Twitter / X',
    value: CONTACT.twitter,
    href: CONTACT.twitter,
    icon: 'x',
    copy: false,
  },
].filter(Boolean) as {
  name: string;
  value: string;
  href?: string;
  icon: string;
  copy: boolean;
}[];
---

<BaseLayout title="Contact" description="Get in touch with Overduerg.">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <header class="mb-14 text-center" data-reveal>
      <p class="mb-2 font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase">
        // contact
      </p>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
        Press <span class="text-gradient">START</span> to talk
      </h1>
      <p class="mx-auto mt-4 max-w-md text-muted">
        Whether it's about a game I'm making, a project, or just to say hi — pick a channel.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        channels.map((channel, i) => (
          <div
            class="card flex items-center gap-4 rounded-xl border border-line bg-panel p-5"
            data-reveal
            style={`--i:${i}`}
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
              {channel.icon === 'github' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                </svg>
              )}
              {channel.icon === 'mail' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 5L2 7" />
                </svg>
              )}
              {channel.icon === 'discord' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 13.78 13.78 0 0 0-.64-1.28c-1.71.29-3.37.8-4.93 1.51A20.3 20.3 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.31-2.1a12.9 12.9 0 0 1-2.06-.98c.17-.13.34-.26.5-.4a14.2 14.2 0 0 0 12.16 0c.16.14.33.27.5.4-.65.39-1.34.72-2.06.98.38.73.82 1.44 1.31 2.1a19.9 19.9 0 0 0 6.08-3.03 20.3 20.3 0 0 0-3.59-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Z" />
                </svg>
              )}
              {channel.icon === 'x' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" />
                </svg>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-medium tracking-wider text-muted uppercase">{channel.name}</p>
              {channel.href ? (
                <a
                  href={channel.href}
                  target={channel.href.startsWith('mailto') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                  class="block truncate font-display font-semibold transition-colors hover:text-accent"
                >
                  {channel.value}
                </a>
              ) : (
                <p class="truncate font-display font-semibold">{channel.value}</p>
              )}
            </div>
            {channel.copy && (
              <button
                type="button"
                data-copy={channel.value}
                class="shrink-0 rounded-md border border-line px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-accent hover:text-accent"
              >
                <span data-copy-label>Copy</span>
              </button>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-muted" data-reveal>
      Prefer async? Open an issue or discussion on any of my GitHub repos.
    </p>
  </div>
</BaseLayout>
