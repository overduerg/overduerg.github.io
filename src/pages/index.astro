---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout>
  <section class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <h1
      class="relative text-center font-display text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
      data-reveal
    >
      Welcome to <span class="text-[#7c3aed] dark:text-[#a78bfa]">OD_studio</span><span
        class="animate-blink text-accent">_</span
      >
    </h1>
  </section>
</BaseLayout>
