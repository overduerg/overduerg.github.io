---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout>
  <section class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <div class="relative flex flex-col items-center px-4">
      <h1
        class="text-center font-display text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
        data-reveal
      >
        Welcome to <span class="text-[#7c3aed] dark:text-[#a78bfa]">{SITE.name}</span><span
          class="text-accent"
          data-cursor>_</span
        >
      </h1>
      <p class="mt-6 max-w-xl text-center text-lg text-muted sm:text-xl" data-reveal style="--i:1">
        {SITE.tagline}
      </p>

      <!-- Current status -->
      <div
        class="mt-12 w-full max-w-xl rounded-xl border border-line bg-panel p-6 text-left"
        data-reveal
        style="--i:2"
      >
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <p
            class="font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase"
          >
            preproduction
          </p>
        </div>
        <p class="mt-3 font-display text-2xl font-bold tracking-tight">3w</p>
        <p class="mt-1 text-sm text-muted">
          Making a small 3D open-world game with many NPCs and random, fun interactions.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
