---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout>
  <section class="flex min-h-[calc(100vh-4rem)] items-center justify-center">
    <div class="relative flex flex-col items-center px-4">
      <h1
        class="text-center font-display text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
        data-reveal
      >
        Welcome to <span class="text-[#7c3aed] dark:text-[#a78bfa]">{SITE.name}</span><span
          class="text-accent"
          data-cursor>_</span
        >
      </h1>
      <p class="mt-6 max-w-xl text-center text-lg text-muted sm:text-xl" data-reveal style="--i:1">
        {SITE.tagline}
      </p>

      <!-- Current status -->
      <div
        class="group mt-12 w-full max-w-xl overflow-hidden rounded-xl border border-line bg-panel text-left transition-colors duration-300 hover:border-accent"
        data-reveal
        style="--i:2"
      >
        <div class="h-1 w-full bg-gradient-to-r from-accent to-accent2"></div>
        <div class="p-6">
          <div class="flex items-center justify-between gap-4">
            <p class="font-mono text-xs font-medium tracking-[0.2em] text-muted uppercase">
              Currently building
            </p>
            <span
              class="flex shrink-0 items-center gap-2 rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"
                ></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
              </span>
              preproduction
            </span>
          </div>

          <p class="mt-4 font-display text-3xl font-bold tracking-tight">3w</p>

          <p class="mt-2 text-sm leading-relaxed text-muted">
            An experimental 3D open-world game built around living NPCs — a small world full of
            characters that roam freely, with random, fun interactions around every corner.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {
              ['3D', 'Open world', 'Many NPCs', 'Random interactions'].map((tag) => (
                <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-medium text-ink/80">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
