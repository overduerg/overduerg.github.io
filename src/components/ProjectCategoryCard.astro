---
interface Props {
  title: string;
  description: string;
  count: number;
  href: string;
  icon: 'produce' | 'consume';
  index?: number;
}

const { title, description, count, href, icon, index = 0 } = Astro.props;
---

<a
  href={href}
  class="card group relative flex flex-col gap-4 overflow-hidden rounded-xl border border-line bg-panel p-6"
  data-reveal
  style={`--i:${index}`}
>
  <div class="flex items-center justify-between">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent-soft text-accent"
    >
      {
        icon === 'produce' ? (
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
            ></path>
          </svg>
        ) : (
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="6" y1="12" x2="10" y2="12"></line>
            <line x1="8" y1="10" x2="8" y2="14"></line>
            <line x1="15" y1="13" x2="15.01" y2="13"></line>
            <line x1="18" y1="11" x2="18.01" y2="11"></line>
            <path
              d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.54-.6-6.58-.68-7.41A4 4 0 0 0 17.32 5z"
            ></path>
          </svg>
        )
      }
    </div>
    <span
      class="font-display text-3xl font-bold text-ink/20 transition-colors duration-200 group-hover:text-accent/50"
    >
      {count}
    </span>
  </div>

  <div>
    <h3 class="font-display text-xl font-bold transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-1 text-sm text-muted">{description}</p>
  </div>

  <span
    class="mt-auto flex items-center gap-1 text-sm font-medium text-muted transition-colors group-hover:text-accent"
  >
    Enter
    <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
  </span>
</a>
