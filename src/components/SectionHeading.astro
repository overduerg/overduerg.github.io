---
interface Props {
  overline: string;
  title: string;
  href?: string;
  hrefLabel?: string;
}

const { overline, title, href, hrefLabel = 'View all' } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4" data-reveal>
  <div>
    <p class="mb-2 font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase">
      {overline}
    </p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  {
    href && (
      <a
        href={href}
        class="group hidden shrink-0 items-center gap-1 text-sm font-medium text-muted transition-colors hover:text-accent sm:flex"
      >
        {hrefLabel}
        <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    )
  }
</div>
