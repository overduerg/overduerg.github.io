---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, description, status, tech, links } = project.data;

const statusStyles: Record<string, { label: string; dot: string }> = {
  active: { label: 'Active', dot: 'bg-emerald-500' },
  maintained: { label: 'Maintained', dot: 'bg-sky-500' },
  wip: { label: 'WIP', dot: 'bg-amber-500' },
  archived: { label: 'Archived', dot: 'bg-zinc-500' },
};
const badge = statusStyles[status];
---

<a
  href={`/projects/${project.id}/`}
  class="card group flex flex-col gap-3 rounded-xl border border-line bg-panel p-5"
  data-reveal
  style={`--i:${index}`}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
    </div>
    <span class="flex items-center gap-1.5 text-xs font-medium text-muted">
      <span class={`h-2 w-2 rounded-full ${badge.dot}`}></span>
      {badge.label}
    </span>
  </div>

  <h3 class="font-display text-lg font-bold transition-colors group-hover:text-accent">{title}</h3>
  <p class="line-clamp-3 flex-1 text-sm text-muted">{description}</p>

  {
    tech.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tech.map((t) => (
          <li class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium text-ink/80">{t}</li>
        ))}
      </ul>
    )
  }

  <div class="flex gap-3 pt-1 text-xs font-medium text-muted">
    {links.github && <span class="transition-colors group-hover:text-ink">GitHub &nearr;</span>}
    {links.demo && <span class="transition-colors group-hover:text-ink">Live demo &nearr;</span>}
  </div>
</a>
