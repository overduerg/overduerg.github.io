---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/contact/', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md"
  transition:name="site-header"
  transition:animate="none"
>
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <span class="logo-icons text-accent transition-transform duration-300 group-hover:rotate-12">
        <!-- Controller -->
        <svg
          class="logo-icon logo-icon--pad"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <path
            d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.54-.6-6.58-.68-7.41A4 4 0 0 0 17.32 5z"
          ></path>
        </svg>
        <!-- Programmer -->
        <svg
          class="logo-icon logo-icon--code"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </span>
      <span data-logo-name class="inline-block min-w-[7rem]"
        >overdue<span class="text-accent">rg</span><span
          class="animate-blink text-accent">_</span
        ></span
      >
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 sm:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive(href) ? 'text-accent' : 'text-muted hover:text-ink',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <button
          type="button"
          data-action="toggle-theme"
          aria-label="Toggle dark mode"
          class="rounded-md p-2 text-muted transition-colors hover:text-ink"
        >
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </li>
    </ul>

    <!-- Mobile buttons -->
    <div class="flex items-center gap-1 sm:hidden">
      <button
        type="button"
        data-action="toggle-theme"
        aria-label="Toggle dark mode"
        class="rounded-md p-2 text-muted transition-colors hover:text-ink"
      >
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button
        type="button"
        data-action="toggle-nav"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="rounded-md p-2 text-muted transition-colors hover:text-ink"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="hidden border-t border-line sm:hidden">
    <ul class="space-y-1 px-4 py-3">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive(href) ? 'bg-accent-soft text-accent' : 'text-muted hover:text-ink',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .logo-icons {
    position: relative;
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .logo-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .logo-icon--pad {
    animation: logo-pad 8s ease-in-out infinite;
  }

  .logo-icon--code {
    animation: logo-code 8s ease-in-out infinite;
  }

  /* Controller visible for the first half of the cycle... */
  @keyframes logo-pad {
    0%,
    40% {
      opacity: 1;
      transform: translateY(0);
    }
    50%,
    90% {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ...programmer icon for the second half. */
  @keyframes logo-code {
    0%,
    40% {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    50%,
    90% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-icon--pad,
    .logo-icon--code {
      animation: none;
    }
    .logo-icon--pad {
      opacity: 1;
    }
    .logo-icon--code {
      opacity: 0;
    }
  }
</style>
