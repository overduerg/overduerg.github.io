---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games-played'>;
  index?: number;
}

const { game, index = 0 } = Astro.props;
const { title, cover, status } = game.data;

// Border glow colour is driven by status.
const statusMeta: Record<string, { label: string; color: string }> = {
  completed: { label: 'Completed', color: '#22c55e' },
  playing: { label: 'Playing', color: '#3b82f6' },
  'on-hold': { label: 'On Hold', color: '#f59e0b' },
  dropped: { label: 'Dropped', color: '#ef4444' },
  backlog: { label: 'Backlog', color: '#94a3b8' },
};
const meta = statusMeta[status];
---

<div class="tab-wrap" data-status={status} data-reveal style={`--i:${index}`}>
  <a
    href={`/projects/consume/${game.id}/`}
    class="game-tab"
    style={`--status:${meta.color}`}
    aria-label={`${title} — ${meta.label}`}
  >
    <div class="media">
      {
        cover ? (
          <Image
            src={cover}
            alt={`${title} cover art`}
            width={1024}
            class="tab-img"
            loading="lazy"
          />
        ) : (
          <div class="tab-placeholder">
            <span>{title.charAt(0)}</span>
          </div>
        )
      }

      <div class="meta">
        <span class="tab-title">{title}</span>
        <span class="tab-status">{meta.label}</span>
      </div>
    </div>
  </a>
</div>

<style>
  .game-tab {
    display: block;
    position: relative;
    border-radius: 1rem;
    border: 2px solid var(--line);
    overflow: hidden;
    background: var(--panel);
    transition:
      border-color 0.3s ease,
      box-shadow 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Glowing border, colour-coded by status */
  .game-tab:hover,
  .game-tab:focus-visible {
    border-color: var(--status);
    box-shadow:
      0 0 0 1px var(--status),
      0 0 30px -4px var(--status),
      0 18px 55px -22px var(--status);
    transform: translateY(-3px);
    outline: none;
  }

  .media {
    position: relative;
    aspect-ratio: 3 / 4;
  }

  .tab-img,
  .tab-placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .game-tab:hover .tab-img,
  .game-tab:focus-visible .tab-img {
    transform: scale(1.04);
  }

  .tab-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 25%, transparent), color-mix(in srgb, var(--accent-2) 20%, transparent));
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  /* Title + status revealed on hover */
  .meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 1.75rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.92), rgb(0 0 0 / 0.5) 55%, transparent);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .game-tab:hover .meta,
  .game-tab:focus-visible .meta {
    opacity: 1;
    transform: none;
  }

  .tab-title {
    /* Reserve two lines for every name so they all sit at the same level,
       regardless of whether the title wraps. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .tab-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--status);
  }

  .tab-status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--status);
    box-shadow: 0 0 10px var(--status);
  }

  /* Touch devices have no hover — always show the label */
  @media (hover: none) {
    .meta {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-tab,
    .meta,
    .tab-img {
      transition: none;
    }
    .game-tab:hover .tab-img {
      transform: none;
    }
  }
</style>
